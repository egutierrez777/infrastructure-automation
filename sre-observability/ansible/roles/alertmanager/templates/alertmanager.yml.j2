global:
  resolve_timeout: 5m

route:
  group_by:
    - alertname
    - severity

  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

  receiver: critical-notifications

  routes:
    - matchers:
        - severity="critical"
      receiver: critical-notifications

receivers:
  - name: critical-notifications
    webhook_configs:
      - url: "http://127.0.0.1:8080/webhook"
        send_resolved: true
