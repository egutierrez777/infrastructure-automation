global:
  scrape_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "localhost:9093"

rule_files:
  - "/etc/prometheus/rules/*.yml"

scrape_configs:

  - job_name: "web-app"
    static_configs:
      - targets:
{% for host in groups['webservers'] %}
          - "{{ hostvars[host]['ansible_host'] }}"
{% endfor %}

  - job_name: "web-node"
    static_configs:
      - targets:
{% for host in groups['webservers'] %}
          - "{{ hostvars[host]['ansible_host']}}:9100"
{% endfor %}
