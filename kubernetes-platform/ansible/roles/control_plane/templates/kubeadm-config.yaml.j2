---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ ansible_host }}"
  bindPort: {{ kubernetes_api_port }}

nodeRegistration:
  criSocket: "{{ kubernetes_cri_socket }}"
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ ansible_host }}"

---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "{{ kubeadm_version.stdout | trim }}"

controlPlaneEndpoint: "{{ kubernetes_control_plane_endpoint }}"

apiServer:
  certSANs:
    - "{{ hostvars[groups['load_balancer'][0]]['ansible_host'] }}"
    - "{{ ansible_host }}"

networking:
  podSubnet: "{{ kubernetes_pod_subnet }}"
  serviceSubnet: "{{ kubernetes_service_subnet }}"
  dnsDomain: "cluster.local"
